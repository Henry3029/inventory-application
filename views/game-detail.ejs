<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; margin: 40px; max-width: 600px; }
    .card { border: 1px solid #ddd; padding: 20px; border-radius: 6px; background: #fdfdfd; }
    .actions { margin-top: 20px; display: flex; gap: 10px; }
    a { text-decoration: none; padding: 8px 12px; border-radius: 4px; color: white; font-size: 14px; }
    .btn-edit { background-color: #ffc107; color: #333; }
    .btn-back { background-color: #6c757d; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🎮 <%= game.title %></h1>
    <hr>
    <p><strong>Release Year:</strong> <%= game.release_year || 'N/A' %></p>
    <p><strong>Rating:</strong> ⭐ <%= game.rating ? game.rating + '/10' : 'N/A' %></p>
    <p><strong>Genre:</strong> <%= game.genre_name || 'N/A' %></p>
    <p><strong>Platform:</strong> <%= game.platform_name || 'N/A' %></p>
  </div>

<div class="actions" style="background: #f9f9f9; padding: 15px; border-radius: 6px; border: 1px solid #eee; margin-top: 20px;">
    <h3>Admin Controls</h3>
    <a href="/games/<%= game.id %>/edit" style="background-color: #ffc107; color: #333; padding: 8px 12px; border-radius: 4px; text-decoration: none;">✏️ Edit Game</a>

    <form action="/games/<%= game.id %>/delete" method="POST" style="margin-top: 15px; display: flex; gap: 10px; align-items: center;">
      <input type="password" name="admin_password" required placeholder="Admin password to delete" style="padding: 6px; font-size: 14px;">
      <button type="submit" style="background-color: #dc3545; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">🗑️ Delete Game</button>
    </form>
    <a href="/" class="btn-back">← Back to Home</a>
  </div>
</body>
</html>
