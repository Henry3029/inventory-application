<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; margin: 40px; max-width: 600px; }
    form { display: flex; flex-direction: column; gap: 15px; margin-top: 20px; }
    label { display: flex; flex-direction: column; font-weight: bold; }
    input, select { padding: 8px; font-size: 16px; margin-top: 5px; }
    button { padding: 10px; background-color: #ffc107; color: #333; border: none; font-size: 16px; cursor: pointer; font-weight: bold; }
    button:hover { background-color: #e0a800; }
    a { display: inline-block; margin-top: 15px; text-decoration: none; color: #007bff; }
  </style>
</head>
<body>
  <h1>✏️ <%= title %></h1>
  <hr>

  <!-- Notice the action points to our POST update route -->
  <form action="/games/<%= game.id %>/update" method="POST">
    <label>
      Game Title:
      <input type="text" name="title" value="<%= game.title %>" required>
    </label>

    <label>
      Release Year:
      <input type="number" name="release_year" value="<%= game.release_year || '' %>">
    </label>

    <label>
      Rating (out of 10):
      <input type="number" step="0.1" min="0" max="10" name="rating" value="<%= game.rating || '' %>">
    </label>

    <label>
      Genre:
      <select name="genre_id">
        <option value="">-- Select Genre --</option>
        <% genres.forEach(genre => { %>
          <option value="<%= genre.id %>" <%= game.genre_id === genre.id ? 'selected' : '' %>>
            <%= genre.name %>
          </option>
        <% }) %>
      </select>
    </label>

    <label>
      Platform:
      <select name="platform_id">
        <option value="">-- Select Platform --</option>
        <% platforms.forEach(platform => { %>
          <option value="<%= platform.id %>" <%= game.platform_id === platform.id ? 'selected' : '' %>>
            <%= platform.name %>
          </option>
        <% }) %>
      </select>
    </label>

    <button type="submit">Update Game</button>
  </form>

  <a href="/games/<%= game.id %>">← Cancel</a>
</body>
</html>
